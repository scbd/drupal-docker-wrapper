{
  "name": "drupal-docker-wrapper",
  "version": "11.4.4",
  "private": true,
  "scripts": {
    "lint:md": "markdownlint '**/*.md' --ignore node_modules",
    "lint:md:fix": "markdownlint '**/*.md' --ignore node_modules --fix",
    "lint:docker": "hadolint Dockerfile || (echo 'Hadolint issues' && exit 1)",
    "lint": "npm run lint:md && npm run lint:docker",
    "lint:fix": "npm run lint:md:fix",
    "test": "./ci/test-ci-locally.sh"
  },
  "devDependencies": {
    "dotenv": "17.2.3",
    "markdownlint": "^0.41.0",
    "markdownlint-cli": "^0.49.0"
  },
  "packageManager": "yarn@1.22.22"
}